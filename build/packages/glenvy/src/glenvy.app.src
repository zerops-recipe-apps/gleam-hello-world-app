{application, glenvy, [
    {vsn, "1.0.1"},
    {applications, [gleam_erlang,
                    gleam_stdlib,
                    nibble,
                    simplifile,
                    startest]},
    {description, "A pleasant way to interact with your environment variables."},
    {modules, [glenvy@dotenv,
               glenvy@env,
               glenvy@internal@lexer,
               glenvy@internal@os,
               glenvy@internal@parser]},
    {registered, []}
]}.
